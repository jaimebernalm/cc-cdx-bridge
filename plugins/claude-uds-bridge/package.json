{
  "name": "claude-uds-bridge",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun src/server.ts",
    "build": "bun run build:backend && bun run build:ui",
    "check": "tsc --noEmit",
    "test": "bun test",
    "smoke:desktop": "bun scripts/desktop-smoke.ts",
    "doctor": "bun src/cli.ts doctor",
    "attach": "bun src/cli.ts attach",
    "verify:installation": "bun scripts/verify-installation.ts",
    "build:backend": "bun build src/server.ts src/hook.ts src/cli.ts --target=bun --minify --outdir=dist",
    "build:ui": "cd ui && bun run build",
    "panel": "bun src/cli.ts panel"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2"
  }
}
